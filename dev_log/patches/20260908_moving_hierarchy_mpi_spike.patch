+/* MPI geometry spike: each owned simplex deposits once on vertex primaries.
+ * The records carry extensive geometry; no primitive or stage divisor is
+ * reconstructed until every remote incident contribution has arrived. */
+struct rd_hier_geometry_record
+{
+  int task, index;
+  double endpoint, divisor, dg;
+};
+
+#ifdef RD_ALE_HIERARCHICAL_ARPAIA
+static double rd_hier_open_rebase[4];
+#endif
+
+static int rd_hier_geometry_compare(const void *a, const void *b)
+{
+  int aa = ((const struct rd_hier_geometry_record *)a)->task;
+  int bb = ((const struct rd_hier_geometry_record *)b)->task;
+  return (aa > bb) - (aa < bb);
+}
+
+static void rd_hier_exchange_geometry(struct rd_hier_geometry_record *records, int count,
+                                      double *endpoint, double *divisor, double *dg)
+{
+  mysort(records, count, sizeof(*records), rd_hier_geometry_compare);
+  int *sc = mymalloc("RDHierSendCount", NTask * sizeof(int));
+  int *rc = mymalloc("RDHierRecvCount", NTask * sizeof(int));
+  int *so = mymalloc("RDHierSendOffset", NTask * sizeof(int));
+  int *ro = mymalloc("RDHierRecvOffset", NTask * sizeof(int));
+  memset(sc, 0, NTask * sizeof(int));
+  for(int j = 0; j < count; j++)
+    sc[records[j].task] += sizeof(*records);
+  MPI_Alltoall(sc, 1, MPI_INT, rc, 1, MPI_INT, MPI_COMM_WORLD);
+  int total = 0;
+  for(int task = 0; task < NTask; task++)
+    {
+      so[task] = task ? so[task-1] + sc[task-1] : 0;
+      ro[task] = total;
+      total += rc[task];
+    }
+  struct rd_hier_geometry_record *got = mymalloc("RDHierGeometryImport", total);
+  MPI_Alltoallv(records, sc, so, MPI_BYTE, got, rc, ro, MPI_BYTE, MPI_COMM_WORLD);
+  for(int j = 0; j < total / (int)sizeof(*got); j++)
+    {
+      int i = got[j].index;
+      if(i < 0 || i >= NumGas || got[j].task != ThisTask)
+        terminate_program("RD hierarchy geometry import has an invalid primary");
+      endpoint[i] += got[j].endpoint;
+      if(divisor)
+        divisor[i] += got[j].divisor;
+      dg[i] += got[j].dg;
+    }
+  myfree(got);
+  myfree(ro);
+  myfree(so);
+  myfree(rc);
+  myfree(sc);
 }
 
